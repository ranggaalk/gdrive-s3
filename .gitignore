node_modules/
dist/
**/data/*.sqlite
**/data/*.sqlite-*
**/data/multipart/
.env
.env.local
*.log
.DS_Store

# Service-account keys, and .env variants the bare `.env` line above misses
# (.env.local, .env.bak.*). These carry live private keys.
.env.*
!.env.example
gdrive-storage-*.json
*service-account*.json

# Deploy scripts: their lock, and database backup archives (PM2 writes to
# ./backups, the Compose container to ./data/backups). Never commit those.
.deploy.lock
/backups/
/data/backups/
