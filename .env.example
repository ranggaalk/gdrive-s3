NODE_ENV=development
APP_NAME=DriveS3 Gateway
APP_ORIGIN=http://localhost:3000
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Hanya domain Workspace ini yang boleh login. Boleh dikosongkan jika hanya
# memakai ALLOWED_EMAILS, tapi minimal salah satu harus diisi.
GOOGLE_WORKSPACE_DOMAIN=example.com
# Daftar email spesifik (dipisah koma) yang boleh login di luar domain
# Workspace di atas, misalnya akun Gmail pribadi. Kosongkan jika tidak perlu.
ALLOWED_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Shared Drive discovery and per-member operations require full Drive scope.
# Changing this value requires users with older grants to reconnect Google.
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive

# Daftar email (dipisah koma) yang boleh membuka menu Pengaturan di dashboard
# dan mengubah GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET secara dinamis (tersimpan
# terenkripsi di database, override env di atas tanpa perlu restart).
# Kosongkan untuk menonaktifkan fitur ini sepenuhnya.
ADMIN_EMAILS=

# Base64 dari tepat 32 byte acak.
MASTER_ENCRYPTION_KEY=

# Base64 dari minimal 32 byte acak.
SESSION_SECRET=

SQLITE_PATH=./data/app.sqlite
MULTIPART_TEMP_DIR=./data/multipart
MULTIPART_TTL_HOURS=24
ORPHAN_RETENTION_HOURS=24

# Upload lebih besar dari nilai ini memakai resumable upload.
DRIVE_RESUMABLE_THRESHOLD_BYTES=5242880
DRIVE_UPLOAD_CHUNK_BYTES=8388608

# trash atau permanent
S3_DELETE_MODE=trash

# Endpoint publik yang diberikan kepada klien S3.
S3_PUBLIC_ENDPOINT=http://localhost:3000
S3_REGION=us-east-1
S3_REQUIRE_TLS=false

# Opsional: aktifkan virtual-hosted-style (bucket.domain.com/key) selain
# path-style (domain.com/bucket/key) yang selalu aktif. Butuh wildcard DNS +
# TLS di reverse proxy. Kosongkan untuk menonaktifkan.
S3_VIRTUAL_HOSTED_DOMAIN=

MAX_SINGLE_PUT_BYTES=5368709120
MAX_MULTIPART_OBJECT_BYTES=536870912000
MAX_PARTS=10000
MIN_MULTIPART_PART_BYTES=5242880

# Batas concurrency per user.
MAX_USER_UPLOADS=2
MAX_USER_DOWNLOADS=4
MAX_USER_DRIVE_REQUESTS=8

# Reliability workers dan retry.
DRIVE_RETRY_MAX_ATTEMPTS=5
CLEANUP_BATCH_SIZE=50
CLEANUP_INTERVAL_MS=60000
STAGING_STALE_AFTER_MS=3600000
RECONCILE_BATCH_SIZE=100
DRIVE_IMPORT_PAGE_SIZE=100
DRIVE_IMPORT_BATCH_SIZE=5
DRIVE_IMPORT_INTERVAL_MS=2000

# Presigned URL expiry (detik). Maksimal 7 hari sesuai konvensi S3.
PRESIGNED_MIN_EXPIRES_SECONDS=1
PRESIGNED_MAX_EXPIRES_SECONDS=604800
MULTIPART_EXPIRY_BATCH_SIZE=50

LOG_LEVEL=info
TRUST_PROXY=false

# Hardening (Milestone 7).
# Batas ukuran body untuk API kontrol (JSON) dan XML S3 (misal
# CompleteMultipartUpload, DeleteObjects). Melampaui batas -> ditolak.
MAX_CONTROL_JSON_BYTES=65536
MAX_S3_XML_BYTES=1048576

# Sajikan build dashboard (STATIC_ROOT) langsung dari server. Nonaktifkan
# saat menggunakan dev proxy Vite terpisah.
SERVE_DASHBOARD=true
STATIC_ROOT=./dist/web

# Rate limit anti-brute-force & anti-abuse. Set RATE_LIMIT_ENABLED=false
# hanya untuk debug lokal singkat.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_CREDENTIAL_CREATE_PER_HOUR=20
RATE_LIMIT_SIGNATURE_FAILURES_PER_MINUTE=30
RATE_LIMIT_S3_PUBLIC_RPS_PER_IP=200
RATE_LIMIT_PUBLIC_SHARE_RPS_PER_IP=50
RATE_LIMIT_MFA_VERIFY_PER_MINUTE=8
RATE_LIMIT_MAX_KEYS=10000
